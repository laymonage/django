{
    "defaults": {
        "runners": ["axe"],
        "timeout": 10000,
        "useIncognitoBrowserContext": false
    },
    "urls": [
        "http://127.0.0.1:8000/en/admin/login/",
        {
            "url": "http://127.0.0.1:8000/en/admin/login/",
